{
  "version": "2.0",
  "tracker": {
    "type": "local",
    "repo": null,
    "github": {
      "use_sub_issues": true,
      "fallback_to_task_list": true,
      "project_id": null
    }
  },
  "classification": {
    "confidence_threshold": 70,
    "type_defaults": {
      "bug": { "pillars": ["testing"] },
      "feature": { "pillars": ["security", "cost", "testing"] },
      "refactor": { "pillars": ["security", "testing"] },
      "chore": { "pillars": [] },
      "docs": { "pillars": [] }
    }
  },
  "labels": {
    "prefix": "specflow:",
    "managed": ["in-progress", "spec-ready", "completed"]
  },
  "context": {
    "fresh_window_threshold": 50000,
    "auto_clear_suggestion": true
  },
  "testing": {
    "enforcement": "strict",
    "coverage_thresholds": {
      "trivial": null,
      "small": null,
      "medium": 70,
      "large": 80,
      "complex": 90
    },
    "test_directory": "auto",
    "smart_selection": true,
    "parallel": true,
    "staged_execution": true,
    "retries": {
      "flaky": 2,
      "timeout": 1
    },
    "uat": {
      "enabled": true,
      "app_url": "http://localhost:3000",
      "headless": "auto",
      "timeout_per_scenario": 30000,
      "screenshot_on_failure": true,
      "screenshot_on_success": false,
      "dependencies": {
        "browser_use": {
          "status": "pending",
          "installed_at": null,
          "version": null,
          "declined_reason": null
        }
      }
    },
    "regression_detection": true,
    "fail_fast": false
  },
  "_docs": {
    "tracker.type": "local | github | jira | linear",
    "tracker.repo": "owner/repo for github, project key for jira/linear",
    "classification.confidence_threshold": "Below this, escalate to user",
    "context.fresh_window_threshold": "Suggest /clear when context exceeds this (tokens)",
    "testing.enforcement": "strict = fail on threshold miss, lenient = warn only",
    "testing.coverage_thresholds": "Minimum coverage % by scope level, null = no requirement",
    "testing.uat.dependencies.browser_use.status": "pending | installed | declined"
  }
}
