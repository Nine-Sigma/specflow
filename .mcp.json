{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "axon": {
      "command": "axon",
      "args": ["serve", "--watch"]
    },
    "specflow": {
      "command": "npx",
      "args": ["tsx", "src/cli.ts", "serve"]
    }
  }
}
