# SpecFlow secrets (UAT credentials)
.specflow/secrets.json

# Runtime state (generated during execution)
.specflow/issues/*.json
.specflow/execution/*
!.specflow/execution/.gitkeep
.specflow/tickets/*
!.specflow/tickets/.gitkeep
.specflow/handoffs/*
!.specflow/handoffs/.gitkeep
!.specflow/handoffs/archive/.gitkeep
.specflow/specs/*
!.specflow/specs/.gitkeep
*.log

# OS files
.DS_Store
**/.DS_Store
